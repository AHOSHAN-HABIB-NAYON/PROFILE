# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
# PORT is set by most hosts automatically. Only set it on your own VPS (default 8080).
APP_URL=https://your-domain.com
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=oryzenx
DB_PASSWORD=
DB_NAME=oryzenx

# Optional: Google login (OAuth client ID of type "Web application")
GOOGLE_CLIENT_ID=

# SMTP (Hostinger mail: smtp.hostinger.com, port 465, SSL). Leave SMTP_HOST empty to only log emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OryzenX BD <no-reply@your-domain.com>
APP_TZ=+06:00

# First Super Admin (for hosting without a terminal). Created on startup only if no Super Admin
# exists yet. Remove these two lines after your first login.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

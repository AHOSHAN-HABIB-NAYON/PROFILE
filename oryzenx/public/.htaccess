# OryzenX — Apache configuration (document root = this /public directory)
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (uncomment when your host terminates TLS here)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  # Clean URLs: everything that is not a real file goes to the front controller
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never serve hidden or backup files
<FilesMatch "(^\.|\.(bak|sql|gz|log|ini|env|lock|md|dist)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg|png|jpg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

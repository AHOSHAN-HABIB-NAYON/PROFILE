# /etc/systemd/system/tradeteam.service
# sudo systemctl daemon-reload && sudo systemctl enable --now tradeteam
[Unit]
Description=TradeTeam trading platform
After=network-online.target mysql.service mariadb.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=tradeteam
Group=tradeteam
WorkingDirectory=/opt/tradeteam
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=STORAGE_DIR=/var/lib/tradeteam
# Optional: EnvironmentFile=/etc/tradeteam.env
ExecStart=/usr/bin/node apps/api/dist/server.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradeteam /opt/tradeteam/apps/web/.next

[Install]
WantedBy=multi-user.target

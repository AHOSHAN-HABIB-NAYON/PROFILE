# ─────────────────────────────────────────────────────────────────────────────
# TradeTeam configuration.
#
# You normally do NOT need this file: on first visit the web installer writes
# storage/runtime.env (mode 0600) with the database, Redis and freshly generated
# secrets. Real environment variables always override storage/runtime.env, so
# you can instead manage everything here / in your process manager.
# Never commit real values. Never expose these to the browser.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Exact public origin (scheme + host). Used for cookies, CSRF, passkeys (WebAuthn RP ID), OAuth and emails.
APP_URL=https://example.com
# Express "trust proxy": loopback | true | false | a CIDR list. Behind nginx on the same host: loopback.
TRUST_PROXY=loopback
# Serve the Next.js frontend from the same process/port (recommended).
SERVE_WEB=true
LOG_LEVEL=info
# Private storage (install lock, runtime.env, uploads). Must NOT be web-accessible.
# STORAGE_DIR=/var/lib/tradeteam

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tradeteam
DB_USER=tradeteam
DB_PASSWORD=change-me
DB_POOL_SIZE=20
DB_SSL=false

# Optional. Leave empty (or remove) on single-server hosting without Redis (e.g. Hostinger Node.js
# apps): the built-in in-memory mode is used. Required for running several instances.
REDIS_URL=redis://127.0.0.1:6379/0

# Generated by the installer. Only set manually if you know what you are doing:
#   SESSION_SECRET  >= 32 random chars
#   ENCRYPTION_KEY  32 random bytes, base64 (openssl rand -base64 32) — encrypts TOTP secrets, SMTP/OAuth/exchange secrets, xpubs
#   WEBHOOK_SECRET  HMAC key for the deposit webhook
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY  Web Push keys (npx web-push generate-vapid-keys)
# SESSION_SECRET=
# ENCRYPTION_KEY=
# WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Process roles (split across processes/instances when scaling; see docs/DEPLOYMENT.md)
RUN_MARKET_DATA=true
RUN_ENGINE=true
RUN_WORKERS=true
AUTO_MIGRATE=true
# INSTANCE_ID=web-1

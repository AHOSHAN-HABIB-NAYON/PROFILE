# All values are optional — the web installer (/install) writes config/config.json.
# Environment variables override the file (handy for Docker / PaaS deploys).
PORT=3000
NODE_ENV=production
# TRUST_PROXY=1            # set when running behind Nginx / a load balancer
# COOKIE_SECURE=true       # force Secure cookies (auto-detected from HTTPS otherwise)
# INSTALL_TOKEN=change-me  # require this token in the installer on public servers

# Database (skip the installer by setting these + APP_KEY + LT_INSTALLED=true, then `npm run migrate`)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=lifetrack
# DB_PASSWORD=secret
# DB_NAME=lifetrack
# APP_KEY=base64-32-random-bytes   # encrypts secrets at rest; never change after install
# APP_URL=https://lifetrack.example.com
# LT_INSTALLED=true

# Optional overrides (otherwise configured in Admin → Settings)
# SMTP_HOST= SMTP_PORT=587 SMTP_SECURE=false SMTP_USER= SMTP_PASS= MAIL_FROM=
# GOOGLE_CLIENT_ID= GOOGLE_CLIENT_SECRET=

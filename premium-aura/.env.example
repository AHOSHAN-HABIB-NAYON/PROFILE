# Premium Aura — required environment variables (Hostinger asks for these on deploy).
# Updating an existing site? Use the SAME values as before, especially DB_* and SESSION_SECRET.
# All other settings (SMTP, API keys, payments) are set in the admin panel.
# Optional variables: docs/ENV-REFERENCE.md
NODE_ENV=production
APP_URL=https://your-domain.com
# false for a brand-new install (shows the installer); true once installed
APP_INSTALLED=false
TRUST_PROXY=1
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
SESSION_SECRET=
# Keep the same value forever (encrypts API keys, SMTP password, 2FA)
ENCRYPTION_KEY=

# ------------------------------------------------------------------
# Premium Aura — environment configuration
# Copy to .env (the installer writes DB/secret values automatically).
# NEVER commit your real .env to Git.
# ------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
# Set when running behind Nginx/Cloudflare: loopback | 1 | true
TRUST_PROXY=loopback
# Comma-separated extra origins allowed to call /api (usually leave empty)
CORS_ORIGINS=
# Optional: require /install?token=<value> to open the installer
INSTALL_TOKEN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=premium_aura
DB_USER=premium_aura
DB_PASSWORD=
DB_POOL_SIZE=10

# 64+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Key for encrypting API credentials / SMTP password / 2FA secrets at rest (defaults to SESSION_SECRET)
ENCRYPTION_KEY=
# Force Secure cookies (auto-enabled when APP_URL starts with https://)
SECURE_COOKIES=

# SMTP fallback (the admin panel SMTP settings take precedence)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_NAME=Premium Aura
SMTP_FROM_EMAIL=

# API provider credentials (referenced by name in Admin → API Management)
TELEROUTEX_API_KEY=
THIRDWAVE_API_KEY=
LAMIX_API_TOKEN=
ENTERPRISESMS_API_TOKEN=
TWO009_API_KEY=

# Payment fallbacks (editable in Admin → System Settings)
BINANCE_PAY_UID=
TRC20_ADDRESS=

# Set to true to run only the web server (e.g. a second instance behind a load balancer)
DISABLE_WORKERS=false

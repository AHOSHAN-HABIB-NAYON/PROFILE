{
  "name": "shopigo",
  "version": "1.0.0",
  "private": true,
  "description": "ShopiGo — Bangladesh-focused COD e-commerce platform",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build -w server && npm run build -w client",
    "start": "node app.js",
    "dev": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "package:update": "node scripts/build-update-package.mjs",
    "keys:update": "node scripts/generate-update-keys.mjs"
  }
}

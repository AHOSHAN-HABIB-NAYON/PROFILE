<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch window (light). Removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/nirapod_window_bg</item>
        <item name="android:navigationBarColor">@color/nirapod_window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <!-- Window behind the Flutter UI while it initializes: the app background colour. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/nirapod_window_bg</item>
    </style>
</resources>

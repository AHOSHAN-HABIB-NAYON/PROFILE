# Copy to .env and fill in. Never commit .env. Secrets live only in the environment.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://family-track.webtecit.com
# Behind Hostinger/NGINX proxy set to true so HTTPS detection and rate limits use the real client
TRUST_PROXY=false
FORCE_HTTPS=false
# Browser origins allowed to call the API (admin and landing are same-origin, usually leave empty)
CORS_ALLOWED_ORIGINS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nirapod_dev
DB_USER=nirapod
DB_PASSWORD=
# Admin panel DB user WITHOUT access to location tables (tools/sql/admin-grants.sql). Required in production.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
DB_POOL_MAX=10

# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_S=900
REFRESH_TTL_DAYS=60
# bcrypt work factor (production refuses < 12)
BCRYPT_COST=12
# Version stored with the "I am 18 or older and I agree to the Terms and Privacy Policy" consent
TERMS_VERSION=2026-10
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the OpenAI key and redeem codes at rest.
MASTER_KEY=

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Per-IP, per-endpoint limit for auth and code endpoints (login, register, verify, codes, child join, ...)
AUTH_RATE_LIMIT_MAX=10
# Per-IP limit for /auth/refresh
REFRESH_RATE_LIMIT_MAX=30

# Profile photos (re-encoded JPEG, no metadata) are written to UPLOAD_DIR/avatars and served at /media/avatars.
# Use a persistent directory outside the web root and outside the deploy folder; back it up.
UPLOAD_DIR=./uploads

# Email (Nodemailer, any SMTP provider). See docs/deploy/email-dns.md for SPF, DKIM, DMARC.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS (port 465); false uses STARTTLS (required) on 587
SMTP_SECURE=false
MAIL_FROM="Nirapod <no-reply@family-track.webtecit.com>"

# Firebase Cloud Messaging service account JSON (file path, outside the web root)
FCM_SERVICE_ACCOUNT_JSON_PATH=
# Comma-separated Google OAuth client ids accepted as ID-token audiences
GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_PLAY_PACKAGE_NAME=app.nirapod.family
# Optional local GeoIP database (MaxMind GeoLite2-Country.mmdb). IPs are never stored.
GEOIP_DB_PATH=
GOOGLE_PLACES_API_KEY=

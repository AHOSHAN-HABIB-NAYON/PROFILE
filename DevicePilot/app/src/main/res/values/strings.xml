    <string name="about_text">DevicePilot helps you understand and manage your Android device using only official Android features. It works offline, needs no account and collects no analytics.</string>
    <string name="about_copyright">© DevicePilot · MD. AHOSHAN HABIB NAYON · webtecit.com</string>
    <string name="privacy_s1_title">No account, no server</string>
    <string name="privacy_s1_text">DevicePilot has no backend, no login, no ads and no analytics. Everything runs on your phone.</string>
    <string name="privacy_s2_title">What is stored</string>
    <string name="privacy_s2_text">Only your settings (theme, units, alerts), firewall rules and the list of APK files you added are saved, in the app\'s private storage on this device. Uninstalling DevicePilot deletes them.</string>
    <string name="privacy_s3_title">Usage Access</string>
    <string name="privacy_s3_text">If you allow Usage Access, app usage time, data usage and app sizes are read to display them. They are never uploaded or shared.</string>
    <string name="privacy_s4_title">Firewall (VPN)</string>
    <string name="privacy_s4_text">The firewall uses Android\'s VpnService only on the device. Traffic of blocked apps is discarded; no traffic is forwarded to a server, logged or inspected.</string>
    <string name="privacy_s5_title">Files</string>
    <string name="privacy_s5_text">Files are accessed only when you pick them with the system file picker. Nothing is deleted without your confirmation.</string>
    <string name="privacy_s6_title">Installing and uninstalling</string>
    <string name="privacy_s6_text">Installs and uninstalls always go through Android\'s own confirmation screens. DevicePilot cannot act silently.</string>
    <string name="onb_1_title">Monitor your device</string>
    <string name="onb_1_text">See RAM, storage, battery and Android\'s thermal status — with the source of every number.</string>
    <string name="onb_2_title">Manage your apps</string>
    <string name="onb_2_text">Search apps, install APKs safely and uninstall what you don\'t need through Android\'s own screens.</string>
    <string name="onb_3_title">Internet firewall</string>
    <string name="onb_3_text">Block internet access for chosen apps with a local, on-device VPN. No traffic leaves through DevicePilot.</string>
    <string name="onb_4_title">Temperature</string>
    <string name="onb_4_text">Track battery temperature and Android\'s thermal warnings, and learn how to cool your phone down.</string>
    <string name="onb_5_title">Your privacy first</string>
    <string name="onb_5_text">No account, no tracking. DevicePilot asks for each permission only when you use the feature that needs it.</string>

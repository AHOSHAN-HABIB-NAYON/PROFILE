<?xml version="1.0" encoding="utf-8"?>
<!--
  A browser must be able to open plain-HTTP sites the user asks for. Such pages are
  marked "Not secure" in the address bar. Mixed content inside HTTPS pages stays blocked
  by the WebView settings. Only system certificate authorities are trusted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

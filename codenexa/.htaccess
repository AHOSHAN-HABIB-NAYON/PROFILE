# ---------------------------------------------------------------
# CodeNexa — Apache / LiteSpeed configuration
# ---------------------------------------------------------------
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # If the site lives in a sub-folder and pretty URLs fail, set RewriteBase:
    # RewriteBase /codenexa/

    # Block direct access to internals
    RewriteRule ^(includes|lang|pages|data)(/|$) - [F,L]
    RewriteRule ^config\.php$ - [F,L]

    # Used by the installer to detect rewrite support
    RewriteRule ^install-rewrite-test$ install/index.php?rwtest=1 [L]

    # Pretty URLs:  /services   /service/web-development
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^service/([a-z0-9-]+)/?$ index.php?p=service&slug=$1 [QSA,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)/?$ index.php?p=$1 [QSA,L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain
</IfModule>

# Long-term caching for static assets (URLs are versioned with ?v=)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|webp|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

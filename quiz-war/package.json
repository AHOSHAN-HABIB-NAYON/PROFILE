{
  "name": "quiz-war",
  "private": true,
  "version": "1.0.0",
  "description": "QUIZ WAR: Bangladesh — realtime multiplayer quiz game (Web + Android + Admin)",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web",
    "apps/admin"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev:server": "npm run dev -w @quizwar/server",
    "dev:web": "npm run dev -w @quizwar/web",
    "dev:admin": "npm run dev -w @quizwar/admin",
    "db:migrate": "npm run db:migrate -w @quizwar/server",
    "db:seed": "npm run db:seed -w @quizwar/server",
    "admin:create": "npm run admin:create -w @quizwar/server",
    "build": "npm run build -w @quizwar/web && npm run build -w @quizwar/admin && npm run build -w @quizwar/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "node apps/server/dist/index.js"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}

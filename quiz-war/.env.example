# ─────────────────────────────────────────────────────────────────────────────
# QUIZ WAR: Bangladesh — environment variables
# Copy to `.env` for local development. In staging/production set these as real
# environment secrets (never commit them). See docs/deployment.md.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | test | staging | production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=false               # true behind nginx / a load balancer

PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://localhost,capacitor://localhost

# MySQL 8 / MariaDB 10.6+
DATABASE_URL=mysql://quizwar:devpass@localhost:3306/quizwar
DATABASE_POOL_SIZE=10
MIGRATE_ON_START=true

# Optional — enables multi-node Socket.IO, shared presence and rate limits
REDIS_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ADMIN_JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12

# Google Identity — Web client ID; Android client IDs go in GOOGLE_EXTRA_AUDIENCES
GOOGLE_CLIENT_ID=
GOOGLE_EXTRA_AUDIENCES=

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=QUIZ WAR: Bangladesh
# Comma separated. Production: https://quizwar.app,android:apk-key-hash:<base64url sha256 of signing cert>
WEBAUTHN_ORIGIN=http://localhost:5173

# Android App Links (assetlinks.json) — Play App Signing + upload key SHA-256, comma separated
ANDROID_PACKAGE_NAME=app.quizwar.bd
ANDROID_SHA256_CERT_FINGERPRINTS=

# Email (verification / password reset). Empty = emails are only logged (dev).
# AI question generator (Admin → AI Generator). Server-side only.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

SMTP_URL=
# …or (easier for Gmail app passwords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=support.quizwarbd@gmail.com
# SMTP_PASS=
MAIL_FROM=QUIZ WAR <no-reply@quizwar.app>

# Push notifications
# Web push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@quizwar.app
# Android (FCM HTTP v1): the Firebase service account JSON as one line
FCM_SERVICE_ACCOUNT_JSON=

# Uploads
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:4000/media
UPLOAD_MAX_BYTES=5242880

{
  "name": "@quizwar/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed-dev.ts",
    "admin:create": "tsx --env-file-if-exists=../../.env src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.5",
    "@quizwar/shared": "1.0.0",
    "@simplewebauthn/server": "13.3.3",
    "@socket.io/redis-adapter": "8.3.0",
    "fastify": "5.12.5",
    "google-auth-library": "10.9.1",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "mysql2": "3.24.5",
    "nodemailer": "10.0.16",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/web-push": "3.6.4",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}

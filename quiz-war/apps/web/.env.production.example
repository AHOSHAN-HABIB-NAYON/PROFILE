# Build-time config for the web/PWA and Android builds (public values only — no secrets!).
# Copy to .env.production (git-ignored) or set in CI.

# API origin. Web on the same domain can leave this empty (relative /api).
# The Android app MUST use an absolute API origin that is NOT the Capacitor hostname
# (capacitor.config.ts server.hostname), e.g. https://api.quizwar.app
VITE_API_URL=https://api.quizwar.app

# Public web origin used for share links, QR codes and War Room invites.
VITE_PUBLIC_WEB_URL=https://quizwar.app

VITE_APP_VERSION=1.0.0

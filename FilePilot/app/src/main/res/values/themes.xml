<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FilePilot" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/fmp_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/fmp_royal_blue</item>
        <item name="colorAccent">@color/fmp_teal</item>
    </style>

    <style name="Theme.FilePilot.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fmp_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.FilePilot</item>
    </style>
</resources>

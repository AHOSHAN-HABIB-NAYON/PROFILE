# ─── চাকরি সার্কুলার — কনফিগারেশন ───
# এই ফাইলটি কপি করে `.env` নামে সেভ করুন, তারপর নিচের মান বসান।
# (.env কখনো গিটে বা পাবলিক ফোল্ডারে রাখবেন না)

NODE_ENV=production
PORT=3000

# ডাটাবেস (hPanel → Databases)
DB_HOST=localhost
DB_NAME=u000000000_jobs
DB_USER=u000000000_jobs
DB_PASS=
DB_POOL=4

# সেশন সই করার গোপন কী — যেকোনো লম্বা এলোমেলো লেখা (৩২+ অক্ষর)
SESSION_SECRET=

# সাইটের ঠিকানা (টেস্টের সময় সাবডোমেইন, পরে মূল ডোমেইন) — শেষে / দেবেন না
BASE_URL=https://test.cakricircular.com

# ছবি/পিডিএফ যেখানে জমা থাকবে (ডিফল্ট: প্রজেক্টের ভেতরের uploads/)
UPLOAD_DIR=./uploads

# প্রক্সির পেছনে থাকলে true (Hostinger-এ true রাখুন)
TRUST_PROXY=true

# অ্যাপ-ভেতরের শিডিউলার (অটোমেশন, ইমেইল, রিমাইন্ডার) — বন্ধ করতে false
SCHEDULER=true

# টেস্ট সাবডোমেইনে true দিন — গুগল ইনডেক্স করবে না। মূল ডোমেইনে false/মুছে দিন।
NOINDEX=true

# মেমরি সীমা (MB) — শেয়ার্ড হোস্টিংয়ের জন্য
MAX_HEAP_MB=256

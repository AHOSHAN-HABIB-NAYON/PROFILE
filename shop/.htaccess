# ---- Premium Shop: Apache configuration (shared-hosting friendly) ----
Options -Indexes -MultiViews
DirectorySlash Off
AddDefaultCharset UTF-8
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (uncomment on production with SSL)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block dotfiles (.env, .git, .htaccess …)
    RewriteRule (^|/)\. - [F,L]

    # Block private application folders and files
    RewriteRule ^(config|core|controllers|models|services|routes|views|storage|database|pwa)(/|$) - [F,L,NC]
    RewriteRule ^(server\.php|README\.md|composer\.(json|lock)|.*\.(sql|log|ini|sh|bak|dist|example))$ - [F,L,NC]

    # No PHP file except the front controller can be requested directly
    RewriteCond %{REQUEST_URI} !^/index\.php$
    RewriteRule \.php$ - [F,L,NC]

    # Never execute scripts from uploads
    RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|svg|js)$ - [F,L,NC]

    # Everything that is not a real file goes to the router (clean URLs)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(css|js|woff2?|svg|png|jpe?g|webp|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/manifest+json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 64M
    php_flag expose_php Off
</IfModule>

# Copy to .env (the installer writes this automatically). Never commit .env.
APP_URL=https://example.com
APP_DEBUG=false
APP_KEY=change-me-to-a-long-random-string
TRUST_PROXY=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=shop
DB_USER=shop
DB_PASS=secret

# Optional: BDCourier API key can be set here or in Admin > Settings > Fraud
BDCOURIER_API_KEY=

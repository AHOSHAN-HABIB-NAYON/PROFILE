# =====================================================================
#  Apache configuration (shared-hosting friendly)
#  - Clean URLs: every route is served by index.php (no ".php" in URLs)
#  - Internal folders and direct .php access are blocked
#  - Long-term caching for versioned assets, compression, security headers
#  If the site lives in a sub-folder, set RewriteBase to that folder.
# =====================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8
ServerSignature Off

# /admin and /api are routes that share their names with code folders:
# don't let mod_dir redirect them to "/admin/".
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # RewriteBase /

  # Force HTTPS (uncomment once SSL is active)
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Hidden files (.git, .env, .htaccess …) are never served
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # "/index.php" → "/" (never show .php in the address bar)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?/] [NC]
  RewriteRule ^(.*/)?index\.php$ /$1 [R=301,L,NE]

  # Any other direct .php request → 404 (pages, api, admin, config…)
  RewriteCond %{THE_REQUEST} \.php[\s?/] [NC]
  RewriteRule !^index\.php$ - [R=404,L]

  # Internal folders are handled by the router (which answers 404 for them).
  # config/, core/, includes/, pages/, database/ and storage/ also carry their
  # own "Require all denied" as a second line of defence.
  RewriteRule ^(config|core|includes|pages|admin|api|database|storage)(/.*)?$ index.php [L,QSA]

  # Dynamic SEO / PWA files generated from admin settings
  RewriteRule ^(manifest\.json|robots\.txt|sitemap\.xml)$ index.php [L,QSA]

  # Real files (assets, service worker) are served directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else → front controller
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Friendly error pages are rendered by PHP; this covers non-PHP 403/404s
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header unset X-Powered-By
  <FilesMatch "\.(css|js|png|jpe?g|webp|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>
